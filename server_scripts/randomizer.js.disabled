	}
	function crushing(output){
		event.custom({
			"type": "create:crushing",
			"ingredients": [
				{
					"item": getRandItem()
				}
			],
			"processing_time": (rand()%10)*50,
			"results": [
				{
					"id": output
				}
			]
		})
	}
	
	function mechcraft_a(output){
		event.custom({
			"type": "create:mechanical_crafting",
			"accept_mirrored": false,
			"category": "misc",
			"key": {
				"A": {
					"item": getRandItem()
				},
				"P": {
					"item": getRandItem()
				},
				"S": {
					"item": getRandItem()
				}
			},
			"pattern": [
				" AAA ",
				"AAPAA",
				"APSPA",
				"AAPAA",
				" AAA "
			],
			"result": {
				"count": 1,
				"id": output
			},
			"show_notification": false
		})
	}
	function mechcraft_b(output){
		event.custom({
			"type": "create:mechanical_crafting",
			"accept_mirrored": false,
			"category": "misc",
			"key": {
				"A": {
					"item": getRandItem()
				},
				"B": {
					"item": getRandItem()
				},
				"C": {
					"item": getRandItem()
				},
				"D": {
					"item": getRandItem()
				},
				"E": {
					"item": getRandItem()
				}
			},
			"pattern": [
				"AAAAAAAAA",
				"ABBBBBBBA",
				"ABCCCCCBA",
				"ABCDDDCBA",
				"ABCDEDCBA",
				"ABCDDDCBA",
				"ABCCCCCBA",
				"ABBBBBBBA",
				"AAAAAAAAA"
			],
			"result": {
				"count": 1,
				"id": output
			},
			"show_notification": false
		})
	}
	function mechcraft_c(output){
		event.custom({
			"type": "create:mechanical_crafting",
			"accept_mirrored": false,
			"category": "misc",
			"key": {
				"A": {
					"item": getRandItem()
				},
				"B": {
					"item": getRandItem()
				}
			},
			"pattern": [
				"ABABABABA",
				"BABABABAB",
				"ABABABABA",
				"BABABABAB",
				"ABABABABA",
				"BABABABAB",
				"ABABABABA",
				"BABABABAB",
				"ABABABABA"
			],
			"result": {
				"count": 1,
				"id": output
			},
			"show_notification": false
		})
	}
	
	let heat_types = ["heated","superheated"]
	function mixing_1a(output){
		var heat = heat_types[rand()%3]
		if (heat == "") {
			event.custom({
			"type": "create:mixing",
			"ingredients": [
				{
					"item": getRandItem()
				},
				{
					"type": "fluid_stack",
					"amount": ((rand() % 20)+1)*25,
					"fluid": getRandFluid()
				},
				{
					"type": "fluid_stack",
					"amount": ((rand() % 20)+1)*25,
					"fluid": getRandFluid()
				}
			],
			"results": [
				{
					"amount": ((rand() % 20)+1)*50,
					"id": output
				}
			]
		})
		}else{
			event.custom({
				"type": "create:mixing",
				"heat_requirement": heat,
				"ingredients": [
					{
						"item": getRandItem()
					},
					{
						"type": "fluid_stack",
						"amount": ((rand() % 20)+1)*25,
						"fluid": getRandFluid()
					},
					{
						"type": "fluid_stack",
						"amount": ((rand() % 20)+1)*25,
						"fluid": getRandFluid()
					}
				],
				"results": [
					{
						"amount": ((rand() % 20)+1)*50,
						"id": output
					}
				]
			})
		}
	}
	function mixing_2a(output){
		var heat = heat_types[rand()%3]
		if (heat == "") {
			event.custom({
