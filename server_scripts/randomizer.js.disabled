// Visit the wiki for more info - https://kubejs.com/
console.info('Hello, World! (Loaded server example script)')

ServerEvents.recipes(event => {
/*
	event.shapeless(
		Item.of('exdeorum:wood_chippings', 1), // arg 1: output
		[
			Item.of('create_blaze_burner_fuels:wood_dust',8)
		]
	)
*/
	event.remove({})
	
	let goalItem = "kubejs:renderium_block"
	let teirs = [["minecraft:oak_log","minecraft:oak_sappling","minecraft:stick","minecraft:apple"]]
	let teirs_f = [[]]
	let unlockedItems = ["minecraft:oak_log","minecraft:oak_sappling","minecraft:stick","minecraft:apple"]
	let unlockedFluids = []
	
	let allItems = Item.getTypeList();
	let allFluids = Fluid.getTypes();
	let seed = 1234;
	
	allItems = allItems.filter(function(e) { return (e !== "minecraft:air") && (e !== "minecraft:barrier") })
	
	let allItemsUnused = allItems
	
	allFluids = allFluids.filter(function(e) { return (e !== "minecraft:empty") && (!e.includes(":flowing_")) })
	
	let allFluidsUnused = allFluids
	
	function rand(){
		seed = (1103515245 * seed + 12345) % (2**31 - 1);
		return seed;
	}
	
	function canUseFluids(){
		return (unlockedItems.includes("create:item_drain") && unlockedItems.includes("create:mechanical_pump") && unlockedItems.includes("create:fluid_pipe") && canPowerCreate() && hasGearCreate())
	}
	
	function canPowerCreate(){
		return (unlockedItems.includes("create:water_wheel")||unlockedItems.includes("create:large_water_wheel")||unlockedItems.includes("create:hand_crank"))
	}
	
	function hasGearCreate(){
		return (unlockedItems.includes("create:cogwheel")||unlockedItems.includes("create:large_cogwheel"))
	}
	
	function getRandItem(){
		return teirs[teirs.length - 1][rand() % ((teirs[teirs.length - 1].length - 1)]
	}
	function getRandFluid(){
		let i = 0
		while ((teirs_f[teirs_f.length - i - 1].length > 0) i >= teirs_f.length){
			i++
		}
		if (teirs_f[teirs_f.length - i - 1].length > 0) {
			return teirs_f[teirs_f.length - i - 1][rand() % (teirs_f[teirs_f.length - i - 1].length - 1)]
		}else{ return false }
	}
	
	function getTrueRandItem(){
		if (allItemsUnused.length > 0) {
			let a = allItemsUnused[rand() % allItemsUnused.length]
			allItemsUnused = allItemsUnused.filter(function(e) { return e != a })
			return a
		}else{ return false }
	}
	function getTrueRandFluid(){
		if (allFluidsUnused.length > 0) {
			let a = allFluidsUnused[rand() % allFluidsUnused.length]
			allFluidsUnused = allFluidsUnused.filter(function(e) { return e != a })
			return a
		}else{ return false }
	}
	
	function recipe2x2_a(output){
		event.shaped(
			Item.of(output, 1), // arg 1: output
			[
				'AB',
				'BA'
			],
			{
				A: getRandItem(),
				B: getRandItem()
			}
		)
	}
	
	function recipe2x2_b(output){
		event.shaped(
			Item.of(output, 1), // arg 1: output
			[
				'AA',
				'AA'
			],
			{
				A: getRandItem()
			}
		)
	}
	
	function recipe3x3_a(output){
		event.shaped(
			Item.of(output, 1), // arg 1: output
			[
				'ABA',
				'BCB',
				'ABA'
			],
			{
				A: getRandItem(),
				B: getRandItem(),
				C: getRandItem()
			}
		)
	}
	function recipe3x3_b(output){
		event.shaped(
			Item.of(output, 1), // arg 1: output
			[
				'BBB',
				' A ',
				' A '
			],
			{
				A: getRandItem(),
				B: getRandItem()
			}
		)
	}
	function recipe3x3_c(output){
		event.shaped(
			Item.of(output, 1), // arg 1: output
			[
				' B ',
				'BAB',
				' B '
			],
			{
				A: getRandItem(),
				B: getRandItem()
			}
		)
	}
	function recipe3x3_d(output){
		event.shaped(
			Item.of(output, 1), // arg 1: output
			[
				'AAA',
				'AAA',
				'AAA'
			],
			{
				A: getRandItem()
			}
		)
	}
	
	function shapeless_a(output){
		event.shapeless(
			Item.of(output, 1),
			[
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem()
			]
		)
	}
	
	function shapeless_b(output){
		event.shapeless(
			Item.of(output, 1),
			[
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem(),
				getRandItem()
			]
		)
	}
	
	function smithing(output){
		event.smithing(
			output,
			getRandItem(),
			getRandItem(),
			getRandItem()
		)
	}
	
	function smelting_a(output){
		event.smelting(output, getRandItem())
	}
	function smelting_b(output){
		event.blasting(output, getRandItem())
	}
	function smelting_c(output){
		event.smoking(output, getRandItem())
	}
	function smelting_d(output){
		event.campfireCooking(output, getRandItem(), 0, 600)
	}
	
	function stonecutting(output){
		event.stonecutting(output, getRandItem())
	}
	
	function filling(output){
		event.custom({
			"type": 'create:filling',
			"ingredients": [
				{
					"item": getRandItem()
				},
				{
					"type": 'fluid_stack',
					"amount": ((rand() % 20)+1)*50,
					"fluid": getRandFluid()
				}
			],
			"results": [
				{
					"id": output
				}
			]
		})
	}
	
	function draining(output_f){
		event.custom({
			"type": 'create:emptying',
			"ingredients": [
				{
					"item": getRandItem()
				}
			],
			"results": [
				{
					"id": "minecraft:air"
				},
				{
					"amount": ((rand() % 20)+1)*50,
					"id": output_f
				}
			]
		})
	}
	
	function splashing(output){
		event.custom({
			"type": "create:splashing",
			"ingredients": [
				{
					"item": getRandItem()
				}
			],
			"results": [
				{
					"id": output
				}
			]
		})
	}
	function sanding(output){
