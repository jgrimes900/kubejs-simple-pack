	}
	
	function makeItemRec(itemId){
		switch (rand() % 27){
			case 0:
				recipe2x2_a(itemId);
				break;
			case 1:
				recipe2x2_b(itemId);
				break;
			case 2:
				shapeless_a(itemId);
				break;
			case 3:
				recipe3x3_a(itemId);
				break;
			case 4:
				recipe3x3_b(itemId);
				break;
			case 5:
				recipe3x3_c(itemId);
				break;
			case 6:
				recipe3x3_d(itemId);
				break;
			case 7:
				shapeless_b(itemId);
				break;
			case 8:
				smithing(itemId);
				break;
			case 9:
				smelting_a(itemId);
				break;
			case 10:
				smelting_b(itemId);
				break;
			case 11:
				smelting_c(itemId);
				break;
			case 12:
				smelting_d(itemId);
				break;
			case 13:
				stonecutting(itemId);
				break;
			case 14:
				filling(itemId);
				break;
			case 15:
				splashing(itemId);
				break;
			case 16:
				sanding(itemId);
				break;
			case 17:
				pressing(itemId);
				break;
			case 18:
				milling(itemId);
				break;
			case 19:
				deploying(itemId);
				break;
			case 20:
				haunting(itemId);
				break;
			case 21:
				crushing(itemId);
				break;
			case 22:
				mechcraft_a(itemId);
				break;
			case 23:
				mechcraft_b(itemId);
				break;
			case 24:
				mechcraft_c(itemId);
				break;
			case 25:
				mixing_2a(itemId);
				break;
			case 26:
				mixing_2b(itemId);
				break;
		}
	}
	
	function makeFluidRec(fluidId){
		switch (rand() % 3){
			case 0:
				draining(fluidId);
				break;
			case 1:
				mixing_1a(fluidId);
				break;
			case 2:
				mixing_1b(fluidId);
				break;
		}
	}
	
	while (unlockedItems.length + unlockedFluids.length < (allItems.length + allFluids.length)/2)
		if (canUseFluids) {
			let id = rand(allItemsUnused.length + allFluidsUnused.length)
			if (id > allItemsUnused.length) {
				let fluidId = getTrueRandFluid()
				makeFluidRec(fluidId)
			}else{
				let itemId = getTrueRandItem()
				makeItemRec(itemId)
			}
		}else{
			let itemId = getTrueRandItem()
			makeItemRec(itemId)
		}
	}
	
})