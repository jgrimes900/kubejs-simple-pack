					},
					{
						"type": "fluid_stack",
						"amount": ((rand() % 20)+1)*25,
						"fluid": getRandFluid()
					},
					{
						"type": "fluid_stack",
						"amount": ((rand() % 20)+1)*25,
						"fluid": getRandFluid()
					}
				],
				"results": [
					{
						"amount": 1,
						"id": output
					}
				]
			})
		}else{
			event.custom({
