		event.custom({
			"type": "create:milling",
			"ingredients": [
				{
					"item": getRandItem()
				}
			],
			"processing_time": (rand()%10)*50,
			"results": [
				{
					"id": output
				}
			]
		})
	}
	function deploying(output){
		event.custom({
			"type": "create:deploying",
			"ingredients": [
				{
					"item": getRandItem()
				},
				{
					"item": getRandItem()
				}
			],
			"results": [
				{
					"id": output
				}
			]
		})
	}
	function haunting(output){
		event.custom({
			"type": "create:haunting",
			"ingredients": [
				{
					"item": getRandItem()
				}
			],
			"results": [
				{
					"id": output
				}
			]
